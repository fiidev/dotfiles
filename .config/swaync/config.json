{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "overlay",
  "layer-shell": true,
  "cssPriority": "application",
  "control-center-margin-top": 12,
  "control-center-margin-bottom": 12,
  "control-center-margin-right": 16,
  "control-center-margin-left": 16,
  "control-center-width": 380,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "notification-window-width": 380,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": false,
  "script-fail-notify": true,
  "widgets": [
    "title",
    "dnd",
    "buttons-grid",
    "mpris",
    "volume",
    "backlight",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Control Center",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true
    },
    "backlight": {
      "label": "󰃠"
    },
    "mpris": {
      "image-size": 56,
      "image-radius": 12
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰖩  Wi-Fi",
          "type": "normal",
          "command": "bash -c '~/.config/rofi/scripts/wifi-menu.sh & swaync-client -cp'"
        },
        {
          "label": "󰂯  Bluetooth",
          "type": "normal",
          "command": "bash -c '~/.config/rofi/scripts/bluetooth-menu.sh & swaync-client -cp'"
        },
        {
          "label": "󰈈  Focus",
          "type": "normal",
          "command": "bash -c '~/.config/hypr/scripts/focus-mode.sh & swaync-client -cp'"
        },
        {
          "label": "󰖔  Night Light",
          "type": "normal",
          "command": "bash -c '~/.config/rofi/scripts/shader-picker.sh & swaync-client -cp'"
        }
      ]
    }
  }
}
